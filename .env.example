# ============================================================
# 계약하자 — 환경 설정 예시
# 실제 값은 .env.local (개발) 또는 Secret Manager (운영) 에 넣으세요. Git 에 올리지 마세요.
# 값이 비어 있는 외부 서비스는 자동으로 Mock 으로 동작합니다 (APP_ENV=production 제외).
# ============================================================

APP_ENV=development                 # development | test | production
PUBLIC_BASE_URL=http://localhost:5173   # 검증 QR/초대 링크에 쓰이는 서비스 주소 (운영: https://도메인)
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://contract:contract@localhost:5432/contract
REDIS_URL=redis://localhost:6379/0

# --- 보안 (start.sh 가 .env.local 에 자동 생성) ---
JWT_SECRET=
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false                 # 운영: true
ADMIN_TOKEN=                        # 운영에서 /admin 접근 토큰

# --- 문서 암호화 키 ---
KEY_PROVIDER=env                    # env(개발) | secret_manager(운영)
DATA_ENCRYPTION_KEY=                # base64 32바이트 (start.sh 자동 생성)
DATA_ENCRYPTION_KEY_VERSION=v1
SECRET_MANAGER_BACKEND=             # aws | gcp
SECRET_MANAGER_KEY_ID=

# --- Toss 로그인 (앱인토스) ---
TOSS_PROVIDER=mock                  # mock | production
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_MTLS_CERT_PATH=                # 앱인토스 콘솔에서 발급한 mTLS 인증서 경로
TOSS_MTLS_KEY_PATH=
TOSS_DECRYPTION_KEY=                # 사용자 정보 복호화 키 (콘솔 발급)
TOSS_AAD=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# --- 결제 ---
PAYMENT_PROVIDER=mock               # mock | production (앱인토스 인앱결제)
TOSS_IAP_SKU_BLOCKCHAIN=            # 앱인토스 콘솔에 등록한 인앱결제 상품 ID
BLOCKCHAIN_PRICE=990

# --- 본인확인 / 전자서명 ---
IDENTITY_PROVIDER=mock              # mock | production (토스인증)
SIGNATURE_PROVIDER=mock             # mock | development | production (토스인증 전자서명)
TOSS_CERT_CLIENT_ID=
TOSS_CERT_CLIENT_SECRET=

# --- OCR ---
OCR_PROVIDER=local                  # local(Tesseract) | provider_a | provider_b
OCR_PROVIDER_A_URL=
OCR_PROVIDER_A_SECRET=
OCR_PROVIDER_B_API_KEY=

# --- 블록체인 (디지털 지문 기록) ---
BLOCKCHAIN_ENABLED=true             # false 면 유료 기록 기능 전체 숨김
BLOCKCHAIN_PROVIDER=mock            # mock | evm | opentimestamps
BLOCKCHAIN_NETWORK=mock             # 예: hardhat-local, polygon-amoy, base-sepolia, polygon-mainnet
BLOCKCHAIN_RPC_URL=                 # 예: http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=             # 운영: Secret Manager 로 주입. 로컬 Hardhat 은 비워두면 잠금해제 계정 사용
BLOCKCHAIN_CONTRACT_ADDRESS=        # 비워두면 로컬 체인에서 자동 배포
BLOCKCHAIN_EXPLORER_TX_URL=         # 예: https://amoy.polygonscan.com/tx
BLOCKCHAIN_CONFIRMATIONS=1
ANCHOR_MODE=single                  # single(MVP) | merkle(확장, 비용 분석 후)
ANCHOR_MAX_ATTEMPTS=5
ANCHOR_RETRY_BASE_SECONDS=5

# --- 업로드 ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30

# --- Rate limit (분당 요청 수) ---
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_VERIFY_PER_MINUTE=30

PDF_BROWSER_EXECUTABLE=             # 비워두면 Playwright 기본 Chromium
